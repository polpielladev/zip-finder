default_platform(:ios)
fastlane_require 'xcodeproj'

def parse_release_branch(branch_name = ENV["CI_BRANCH"])
  split_git_ref = branch_name.split("/", -1)
  
  if split_git_ref.length != 3
    UI.user_error!("Invalid branch name: #{branch_name}, expected format: release/{platform}/{version}")
  end

  platform = split_git_ref[1].downcase
  version_number = split_git_ref.last

  puts "🚀 Parsed release branch: #{platform} #{version_number}"
  
  { platform: platform, version: version_number }
end


def set_all_xcodeproj_version_and_build_numbers(version_number, platform)
    project = Xcodeproj::Project.open('../ZipFinder.xcodeproj')
    testflight_platform_name = ""
    targets = project.targets
    if platform == "ios"
      testflight_platform_name = "ios"
      targets = targets.select { |target| target.name == "ZipFinder" }
    elsif platform == "macos"
      testflight_platform_name = "osx"
      targets = targets.select { |target| target.name == "ZipFinderForMacOS" }
    else
      UI.user_error!("Invalid platform: #{platform}, allowed values are: ios, macos")
    end

    build_number = latest_testflight_build_number(platform: testflight_platform_name) + 1

    targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings["MARKETING_VERSION"] = version_number
        config.build_settings["CURRENT_PROJECT_VERSION"] = build_number
      end
    end
    project.save
end

# Common release logic that can be used by any platform
def release(options)
  platform = options[:platform]
  version = options[:version]
  
  # fastlane match
  setup_ci

  asc_key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
  asc_issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  asc_key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]

  app_store_connect_api_key(
	  key_id: asc_key_id,
	  issuer_id: asc_issuer_id,
	  key_content: asc_key_content
	)

  sync_code_signing(
    type: "appstore",
    app_identifier: ["dev.polpiella.ZipFinder"],
    readonly: true,
    platform: platform,
    additional_cert_types: platform == "macos" ? ["mac_installer_distribution"] : [],
  )

  xcodes(version: "16.3", select_for_current_build_only: true)

  update_version_and_build_number_if_needed(platform: platform, version: version)

  scheme_name = case platform
  when "ios"
    "ZipFinder"
  when "macos"
    "ZipFinderForMacOS"
  else
    UI.user_error!("Unsupported platform: #{platform}")
  end

  build_app(scheme: scheme_name)
  upload_to_app_store(force: true, precheck_include_in_app_purchases: false)
end

def update_version_and_build_number_if_needed(options)
  set_all_xcodeproj_version_and_build_numbers(options[:version], options[:platform])
  
  if git_status(path: "ZipFinder.xcodeproj/project.pbxproj").empty?
    puts "🚀 Nothing to commit, pushing the same version again!"
  else
    Dir.chdir("..") do
      sh("git add ZipFinder.xcodeproj/project.pbxproj")
      sh("git commit -m '[ci skip] [🚀 release #{options[:platform]}] Updating version to: #{options[:version]}'")
    
      sh("git push https://polpielladev:#{ENV["GITHUB_TOKEN"]}@github.com/polpielladev/zip-finder.git")
    end
  end
end

# release/ios/*.*.*
# release/macos/*.*.*

# bundle exec fastlane release_from_branch

desc "Run release for the platform specified in the branch name"
lane :release_from_branch do
  release_info = parse_release_branch
  platform = release_info[:platform]
  version = release_info[:version]
  
  release(platform: platform, version: version)
end

desc "Generate profiles and certificates"
lane :generate_profiles_and_certificates do
    sync_code_signing(
        type: "appstore",
        app_identifier: ["dev.polpiella.ZipFinder"],
        readonly: false,
        platform: "macos",
        additional_cert_types: ["mac_installer_distribution"]
    )

    sync_code_signing(
        type: "development",
        app_identifier: ["dev.polpiella.ZipFinder"],
        readonly: false,
        platform: "macos"
    )

    sync_code_signing(
      type: "appstore",
      app_identifier: ["dev.polpiella.ZipFinder"],
      readonly: false,
      platform: "ios"
  )

  sync_code_signing(
      type: "development",
      app_identifier: ["dev.polpiella.ZipFinder"],
      readonly: false,
      platform: "ios"
  )
end
